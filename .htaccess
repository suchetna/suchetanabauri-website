# Suchetana Bauri — static site rules (Apache / Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https and the main domain without www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(suchetanabauri\.com)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old test-site folder -> home page
RewriteRule ^new(/.*)?$ / [L,R=301]

# Old WordPress pages and posts (exported 4 Nov 2026) -> new pages
RewriteRule ^ai-enablement-consulting-services/?$ /#services [NE,L,R=301]
RewriteRule ^ai-adoption-case-studies/?$ /work/ [NE,L,R=301]
RewriteRule ^ai-adoption-notes/?$ /blog/ [NE,L,R=301]
RewriteRule ^ai-adoption-consultation/?$ /#contact [NE,L,R=301]
RewriteRule ^ai-strategy-consulting-engagement/?$ /services/ai-enablement/ [NE,L,R=301]
RewriteRule ^workflow-operating-model-design/?$ /services/ai-enablement/ [NE,L,R=301]
RewriteRule ^adoption-training-service-page/?$ /services/ai-enablement/ [NE,L,R=301]
RewriteRule ^ai-experience-design/?$ /services/design/ [NE,L,R=301]
RewriteRule ^corporate-ai-communications/?$ /services/communications/ [NE,L,R=301]
